# .env — Variables de entorno para Backend El Serrucho
# Copiar este archivo como .env y completar con los valores reales
# ESTE ARCHIVO NO DEBE SUBIRSE A GIT (ya está en .gitignore)
# Los valores reales se obtienen en: Supabase Dashboard → Settings → API

# ─── Supabase REST API ────────────────────────────────────────────────────────
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=sb_publishable_TU_KEY_AQUI
SUPABASE_REST_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_ANON_JWT_AQUI

# ─── Tasa de cambio USD → Bs (fallback inicial, el sistema la actualiza automáticamente) ───
TASA_BS=100.0

# ─── Puerto de la API Flask ───────────────────────────────────────────────────
PORT=5000

# ─── Auth para endpoints de sync ─────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Dejar vacío para deshabilitar auth (solo desarrollo)
SYNC_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ─── Alertas (opcional) ───────────────────────────────────────────────────────
# Discord: webhook de canal / Slack: Incoming Webhook URL
ALERT_WEBHOOK_URL=

# ─── Supabase service_role (OPCIONAL — modo de escritura restringida) ────────
# Se obtiene en: Supabase Dashboard → Settings → API → service_role (secret).
# NUNCA debe exponerse fuera de esta PC (no subir a git, no compartir, no
# incluir en apps externas ni en el catálogo público).
# Si se completa esta variable, las ESCRITURAS a Supabase (upsert/insert/update/
# delete) empiezan a usar esta clave en vez de la anon key; las LECTURAS
# (SELECT) siguen siendo con anon como siempre.
# Este valor va de la mano con sql/harden_rls.sql: ese script restringe
# INSERT/UPDATE/DELETE a service_role, así que solo debe ejecutarse en Supabase
# DESPUÉS de haber completado esta variable aquí y reiniciado el backend
# (start_backend.vbs). Ver SECURITY-RLS.md para el procedimiento completo.
# Dejar vacío = comportamiento actual (todo con anon key).
SUPABASE_SERVICE_KEY=
