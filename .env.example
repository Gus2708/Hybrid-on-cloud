# .env — Variables de entorno para Backend El Serrucho
# Copiar este archivo como .env y completar con los valores reales
# Este archivo NO debe subirse a git (ya está en .gitignore)

# ─── Supabase REST API ────────────────────────────────────────────────────────
SUPABASE_REST_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=REDACTED-JWT

# ─── Tasa de cambio USD → Bs (actualizar diariamente) ────────────────────────
TASA_BS=100.0

# ─── Ruta al CSV fuente (solo si difiere del default) ────────────────────────
# CSV_SOURCE_PATH=C:\Users\OFICINA\Clawdbot\scripts\MAESTRO_ACTUAL.csv

# ─── Puerto de la API Flask ───────────────────────────────────────────────────
# PORT=5000

# ─── Modo debug de Flask (0=producción, 1=debug con recarga automática) ───────
# FLASK_DEBUG=0
